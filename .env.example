# Nhà cung cấp LLM: mock (mặc định, không cần internet) | anthropic | openai | gemini
LLM_PROVIDER=mock

# Dùng khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Dùng khi LLM_PROVIDER=openai (bắt buộc điền tên model)
OPENAI_API_KEY=
OPENAI_MODEL=

# Dùng khi LLM_PROVIDER=gemini (key lấy ở Google AI Studio, bắt buộc điền tên model)
# Key miễn phí: nên dùng gemini-3.5-flash-lite (15 lượt/phút, 500 lượt/ngày, khoảng 2-3 giây/lượt)
GEMINI_API_KEY=
GEMINI_MODEL=

# Nhận dạng giọng nói: web (mặc định, Web Speech của Chrome, gửi âm thanh lên Google) | zipformer (chạy trên máy, cần npm run tai-model-giong-noi)
ASR_PROVIDER=web
