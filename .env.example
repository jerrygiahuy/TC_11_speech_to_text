# Nhà cung cấp LLM: mock (mặc định, không cần internet) | anthropic | openai | gemini
LLM_PROVIDER=mock

# Luồng khám: mock xử lý nội bộ. Bệnh án cấp 2 bị chặn với mọi provider bên ngoài, kể cả sau masking.
# Chưa có adapter LLM nội bộ; đổi tên provider không tạo quyền gửi dữ liệu.
CLINICAL_LLM_PROVIDER=mock

# Dùng khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Dùng khi LLM_PROVIDER=openai (bắt buộc điền tên model)
OPENAI_API_KEY=
OPENAI_MODEL=

# Dịch vụ Zipformer STT local (chạy scripts/start-stt.ps1)
STT_BACKEND_URL=http://127.0.0.1:8765

# Lớp NER che PII (PhoBERT local, sau bộ rule R1–R8): on | off. Mặc định bật từ 18/11/2026 (eval-pii: câu STT 29,7% → 64,9%, che nhầm không tăng).
# Để trống cũng là bật; chỉ PII_NER=off mới tắt.
# NER lỗi hoặc quá thời gian thì vẫn che bằng rule. NER_BACKEND_URL trống thì dùng STT_BACKEND_URL.
PII_NER=on
PII_NER_TIMEOUT_MS=2000
NER_BACKEND_URL=
# Dùng khi LLM_PROVIDER=gemini (key lấy ở Google AI Studio, bắt buộc điền tên model)
# Chọn model hiện có trong tài khoản Google AI Studio; hạn mức tùy tài khoản/model.
GEMINI_API_KEY=
GEMINI_MODEL=

# Nhận dạng bệnh án: chỉ Zipformer cục bộ; Web Speech/cloud bị chặn.
ASR_PROVIDER=zipformer

# Optional local Community-1 (file postprocessing only; not denoising).
# Install scripts/setup-community.ps1; accept model access and authenticate Hugging Face locally.
# STT_COMMUNITY_MODEL_DIR=models/community-1
# Admission guard, not a guarantee of peak RAM. Default 4 GiB available.
# STT_COMMUNITY_MIN_AVAILABLE_BYTES=4294967296
# STT_COMMUNITY_TIMEOUT_SECONDS=1800

# Optional DeepFilterNet3 native CPU executable (npm run stt:denoise:setup).
# Denoising remains off unless selected for each upload or new session.
# DENOISE_EXECUTABLE=models/denoise/deep-filter.exe
