vertex="1" parent="1"><mxGeometry x="750" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="p2-a4" value="Tạo phiên “nhập tay” cho lượt khám" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="510" width="240" height="60" as="geometry"/></mxCell><UserObject label="Sang &lt;b&gt;Phần chung&lt;/b&gt;:&lt;br&gt;lọc dữ liệu nhạy cảm (R1–R14)" link="data:page/id,p3" id="p2-toCommon"><mxCell style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;size=0.22;" vertex="1" parent="1"><mxGeometry x="720" y="620" width="260" height="90" as="geometry"/></mxCell></UserObject><mxCell id="p2-noteVT" value="&lt;b&gt;Hiện tại:&lt;/b&gt; bước tách nội dung chưa mở viết tắt. Bảng viết tắt (viet-tat.json) mới dùng khi tìm danh mục ở 2B." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="260" height="90" as="geometry"/></mxCell><mxCell id="p2-edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-s" target="p2-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-a1" target="p2-a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-a2" target="p2-a3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="350"/><mxPoint x="190" y="350"/></Array></mxGeometry></mxCell><mxCell id="p2-edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-a3" target="p2-d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge5" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-d2" target="p2-a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-a4" target="p2-toCommon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge7" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-d2" target="p2-toCommon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="410"/><mxPoint x="1000" y="665"/></Array></mxGeometry></mxCell><mxCell id="p2-g2b" value="2B · Gõ tắt ngay trên phiếu — chạy trên máy bác sĩ, không gửi nội dung đi nên không qua bước lọc" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;swimlaneFillColor=#fcfaff;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="800" height="660" as="geometry"/></mxCell><mxCell id="p2-b1" value="Gõ tắt vào ô &lt;b&gt;ICD / dịch vụ / thuốc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-b2" value="Mở viết tắt theo bảng viết tắt (viet-tat.json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1295" y="150" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-b3" value="Tìm trong danh mục: khớp đúng tên trước, rồi tìm gần đúng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="150" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-b4" value="Bác sĩ chọn một dòng.&lt;br&gt;&lt;b&gt;Mã do danh mục gán&lt;/b&gt;, AI không tự điền mã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1685" y="150" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-c1" value="Chọn &lt;b&gt;mẫu câu khám&lt;/b&gt; gợi ý theo lý do khám" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-c2" value="Chọn từng lựa chọn trong mẫu câu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1295" y="300" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-c3" value="Chèn câu hoàn chỉnh vào ô &lt;b&gt;Khám chuyên khoa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="300" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-e1" value="Phiếu đã có &lt;b&gt;chẩn đoán&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="450" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-e2" value="Gợi ý &lt;b&gt;ICD10&lt;/b&gt; và gợi ý &lt;b&gt;chỉ định theo chẩn đoán&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1295" y="450" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-e3" value="Bác sĩ bấm thêm nhanh từng dòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="450" width="175" height="80" as="geometry"/></mxCell><mxCell id="p2-f" value="&lt;b&gt;Phiếu khám và Chỉ định cập nhật&lt;/b&gt;&lt;br&gt;Bác sĩ sửa, lưu, duyệt, in (như cuối Phần chung)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="610" width="340" height="90" as="geometry"/></mxCell><mxCell id="p2-edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-b1" target="p2-b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-b2" target="p2-b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-b3" target="p2-b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-b4" target="p2-f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-c1" target="p2-c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-c2" target="p2-c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="p2-c3" target="p2-f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-e1" target="p2-e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-e2" target="p2-e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-edge17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-e3" target="p2-f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-note" value="&lt;b&gt;Lưu ý:&lt;/b&gt; eForm “/” và trang &lt;b&gt;/demo-luong&lt;/b&gt; cùng dùng bộ rule &lt;b&gt;pii-auto-1 (R1–R14)&lt;/b&gt; (từ 17/11/2026). Không còn bước bác sĩ duyệt tay bản đã che trước AI." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="1920" y="70" width="260" height="130" as="geometry"/></mxCell><mxCell id="p2-lg" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1930" y="230" width="240" height="30" as="geometry"/></mxCell><mxCell id="p2-lg1" value="Bác sĩ thao tác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="264" width="240" height="34" as="geometry"/></mxCell><mxCell id="p2-lg2" value="Hệ thống xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="306" width="240" height="34" as="geometry"/></mxCell><mxCell id="p2-lg3" value="Điều kiện rẽ nhánh" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="348" width="200" height="60" as="geometry"/></mxCell><mxCell id="p2-lg4" value="🛡 Rule lọc dữ liệu nhạy cảm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1930" y="416" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2-lg5" value="🛡 Biện pháp bảo vệ khác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e7;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="464" width="240" height="34" as="geometry"/></mxCell><mxCell id="p2-lg6" value="Chú thích" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="1930" y="506" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2-lg7" value="Sang trang khác (bấm để mở)" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;size=0.22;" vertex="1" parent="1"><mxGeometry x="1970" y="554" width="160" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Phần chung: lọc dữ liệu nhạy cảm → AI → duyệt"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-title" value="Phần chung · Lọc dữ liệu nhạy cảm (R1–R14) → AI tạo nháp → bác sĩ duyệt" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1220" height="40" as="geometry"/></mxCell><mxCell id="p3-lane1" value="Bác sĩ" style="swimlane;startSize=36;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=14;fontStyle=1;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="320" height="2560" as="geometry"/></mxCell><mxCell id="p3-lane2" value="Máy chủ trong viện" style="swimlane;startSize=36;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=14;fontStyle=1;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="900" height="2560" as="geometry"/></mxCell><mxCell id="p3-in" value="Nhận &lt;b&gt;bản thô&lt;/b&gt; từ Luồng 1 (nói) hoặc Luồng 2A (gõ)" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;size=0.22;flipV=0;" vertex="1" parent="1"><mxGeometry x="660" y="105" width="300" height="70" as="geometry"/></mxCell><mxCell id="p3-shield" value="🛡 LỌC DỮ LIỆU NHẠY CẢM · bộ rule pii-auto-1 (R1–R14) · chạy trên máy chủ, trước khi gửi AI" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=14;fontStyle=1;swimlaneFillColor=#fff7f6;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="840" height="1390" as="geometry"/></mxCell><mxCell id="p3-k1" value="Lấy danh sách &lt;b&gt;định danh đã biết&lt;/b&gt; từ hồ sơ đang mở: họ tên, PID, mã khám, SĐT, địa chỉ, người nhà, nơi làm việc, bác sĩ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="262" width="600" height="60" as="geometry"/></mxCell><mxCell id="p3-sub" value="Che tự động: R1–R8 chạy cùng lúc, nhãn che theo R10" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#fde8e7;strokeColor=#b85450;dashed=1;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="350" width="800" height="545" as="geometry"/></mxCell><mxCell id="p3-r1" value="&lt;b&gt;🛡 R1 · Định danh đã biết&lt;/b&gt;&lt;br&gt;Che tên bệnh nhân, người nhà, người sống cùng, nơi làm việc, bác sĩ (có dấu và không dấu) → [BỆNH_NHÂN], [NGƯỜI_NHÀ_n], [BÁC_SĨ]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA Safe Harbor; NĐ 356&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="395" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r2" value="&lt;b&gt;🛡 R2 · Tên người lạ&lt;/b&gt;&lt;br&gt;Che tên chưa có trong hồ sơ, nhận theo “tên là”, “anh/chị/ông/bà…”, họ người Việt → [NGƯỜI_n]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (A); NĐ 356&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="815" y="395" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r3" value="&lt;b&gt;🛡 R3 · Địa danh nhỏ hơn tỉnh&lt;/b&gt;&lt;br&gt;Che số nhà, đường, xã/phường, quận/huyện, thôn/ấp, quê quán, nơi sinh → [ĐỊA_DANH_n]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (B)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="500" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r4" value="&lt;b&gt;🛡 R4 · Mốc ngày&lt;/b&gt;&lt;br&gt;Che ngày sinh, nhập/xuất viện, khám, mất. &lt;b&gt;Giữ&lt;/b&gt; khoảng thời gian bệnh (“3 ngày nay”) → [NGÀY]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (C)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="815" y="500" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r5" value="&lt;b&gt;🛡 R5 · Liên hệ&lt;/b&gt;&lt;br&gt;Che số điện thoại, fax, email, URL, địa chỉ IP → [LIÊN_HỆ]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (D, E, F, N, O)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="605" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r6" value="&lt;b&gt;🛡 R6 · Mã định danh&lt;/b&gt;&lt;br&gt;Che CCCD/CMND, hộ chiếu, BHYT, PID, mã hồ sơ, tài khoản, bằng lái, biển số, số seri thiết bị → [MÃ_ĐỊNH_DANH]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (G–M); NĐ 356&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="815" y="605" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r7" value="&lt;b&gt;🛡 R7 · Thông tin nhạy cảm&lt;/b&gt;&lt;br&gt;Che quốc tịch, dân tộc, tôn giáo, quan điểm chính trị, xu hướng tình dục, hôn nhân → [THÔNG_TIN_NHẠY_CẢM]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: NĐ 356 – dữ liệu nhạy cảm&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="710" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r8" value="&lt;b&gt;🛡 R8 · Chuyện ngoài khám&lt;/b&gt;&lt;br&gt;Bỏ chuyện đời tư, bí mật gia đình. &lt;b&gt;Giữ&lt;/b&gt; tiền sử bệnh gia đình nhưng bỏ tên → [NỘI_DUNG_NGOÀI_KHÁM]&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: NĐ 356&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="815" y="710" width="380" height="95" as="geometry"/></mxCell><mxCell id="p3-r10" value="&lt;b&gt;🛡 R10 · Nhãn không lộ danh tính&lt;/b&gt;: nhãn chỉ là số thứ tự trong lượt. Bảng nhãn ↔ giá trị thật chỉ ở bộ nhớ, không gửi AI, không ghi log, không lưu.&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA §164.514(c); ISO/IEC 20889&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="815" width="770" height="65" as="geometry"/></mxCell><mxCell id="p3-clean" value="&lt;b&gt;Bản đã che&lt;/b&gt; (bản sạch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="925" width="300" height="50" as="geometry"/></mxCell><mxCell id="p3-r11" value="&lt;b&gt;🛡 R11 · Chốt chặn&lt;/b&gt;&lt;br&gt;Bản sạch còn sót&lt;br&gt;thông tin nhận dạng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1005" width="340" height="140" as="geometry"/></mxCell><mxCell id="p3-r11n" value="&lt;b&gt;R11 kiểm còn sót:&lt;/b&gt;&lt;br&gt;(a) giá trị đã biết của R1, kể cả không dấu&lt;br&gt;(b) dãy từ 6 chữ số trở lên&lt;br&gt;(c) tên riêng ≥ 2 từ không có trong danh mục thuốc, thuật ngữ&lt;br&gt;(d) email, URL&lt;br&gt;&lt;b&gt;Còn sót thì tự che&lt;/b&gt; ([NGƯỜI_KHÁC], [MÃ_ĐỊNH_DANH], [LIÊN_HỆ]…) rồi kiểm lại&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: Luật 91/2025 Đ14 khoản 6, Đ20&lt;/i&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="1000" y="990" width="215" height="170" as="geometry"/></mxCell><mxCell id="p3-stop" value="⛔ Tự che xong vẫn sót: dừng, &lt;b&gt;KHÔNG gửi AI&lt;/b&gt;.&lt;br&gt;Hiện lý do theo mã rule (vd. R11c).&lt;br&gt;Vẫn ghi nhật ký R13 (kết quả: bị chặn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a2e2b;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1025" width="260" height="95" as="geometry"/></mxCell><mxCell id="p3-retry" value="Bác sĩ sửa hoặc ghi lại nội dung, rồi chạy lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1160" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-r12" value="&lt;b&gt;🛡 R12 · Tối thiểu dữ liệu&lt;/b&gt;: chỉ gửi bản đã che + phiên bản prompt/schema. Thông tin hành chính trên phiếu lấy từ hồ sơ, không nhờ AI trích.&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: Luật 91/2025 Đ3, Đ30; ISO/IEC 29100&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="510" y="1185" width="600" height="80" as="geometry"/></mxCell><mxCell id="p3-r14" value="&lt;b&gt;🛡 R14 · Đồng ý&lt;/b&gt;&lt;br&gt;Bệnh nhân đã đồng ý xử lý AI&lt;br&gt;(ghi lúc tiếp đón)?&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: Luật 91/2025 Đ26&lt;/i&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1300" width="380" height="160" as="geometry"/></mxCell><mxCell id="p3-chua" value="Chỉ chạy &lt;b&gt;bộ tách quy tắc trên máy chủ&lt;/b&gt;, không gọi AI bên ngoài" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1490" width="330" height="70" as="geometry"/></mxCell><mxCell id="p3-roi" value="Được phép gửi AI.&lt;br&gt;(Hiện vẫn chạy bộ tách trên máy chủ, chưa nối AI ngoài)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1490" width="330" height="70" as="geometry"/></mxCell><mxCell id="p3-edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-in" target="p3-k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-k1" target="p3-sub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="p3-sub" target="p3-clean"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-clean" target="p3-r11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge5" value="Còn sót" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-r11" target="p3-stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-stop" target="p3-retry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge7" value="chạy lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-retry" target="p3-in"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="1190"/><mxPoint x="55" y="140"/></Array></mxGeometry></mxCell><mxCell id="p3-edge8" value="Sạch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-r11" target="p3-r12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-r12" target="p3-r14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge10" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3-r14" target="p3-chua"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge11" value="Đã đồng ý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3-r14" target="p3-roi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-ai1" value="&lt;b&gt;AI tách nội dung&lt;/b&gt;: tóm tắt, bệnh sử, khám, chẩn đoán, chỉ định, lời dặn, hẹn tái khám.&lt;br&gt;Không kê đơn, không tự điền mã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1640" width="340" height="80" as="geometry"/></mxCell><mxCell id="p3-ai2" value="&lt;b&gt;Kiểm tra bản nháp&lt;/b&gt;: mỗi ý phải có câu nguồn; quyết định lâm sàng chỉ lấy từ lời bác sĩ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1760" width="340" height="70" as="geometry"/></mxCell><mxCell id="p3-ai3" value="&lt;b&gt;Khớp danh mục&lt;/b&gt; để gán mã dịch vụ (bằng code, không phải AI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1870" width="340" height="60" as="geometry"/></mxCell><mxCell id="p3-ai4" value="&lt;b&gt;Lưu vào phiếu&lt;/b&gt; thành bản mới. Ô bác sĩ đã sửa không bị AI ghi đè" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1970" width="340" height="60" as="geometry"/></mxCell><mxCell id="p3-r13" value="&lt;b&gt;🛡 R13 · Nhật ký kiểm tra&lt;/b&gt;&lt;br&gt;Mỗi lượt ghi: số mục đã che theo từng rule, phiên bản rule, mã băm bản gửi AI, kết quả R11, nơi xử lý. &lt;b&gt;Không ghi giá trị thật.&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: Luật 91/2025 Đ14 khoản 6a&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="1925" width="240" height="150" as="geometry"/></mxCell><mxCell id="p3-bs1" value="Xem bản nháp: tóm tắt, chẩn đoán, điểm cần xem lại, câu nguồn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2080" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-bs2" value="Chọn &lt;b&gt;nhận / bỏ&lt;/b&gt; từng đề xuất. Phiếu khám và Chỉ định cập nhật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2180" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-bs3" value="Sửa, chọn ICD và dịch vụ, rồi &lt;b&gt;Lưu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2280" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-d3" value="Tab khác đã&lt;br&gt;lưu trước?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="2260" width="220" height="100" as="geometry"/></mxCell><mxCell id="p3-conflict" value="Báo xung đột, mở lại bản mới nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="2280" width="220" height="60" as="geometry"/></mxCell><mxCell id="p3-bs4" value="&lt;b&gt;Duyệt&lt;/b&gt; phiếu và chỉ định" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2410" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-bs5" value="&lt;b&gt;In phiếu&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="2510" width="200" height="70" as="geometry"/></mxCell><mxCell id="p3-noteDuyet" value="Sửa sau khi duyệt thì không in được: phải lưu và duyệt lại." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="400" y="2500" width="260" height="60" as="geometry"/></mxCell><mxCell id="p3-edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-chua" target="p3-ai1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3-roi" target="p3-ai1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-ai1" target="p3-ai2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-ai2" target="p3-ai3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-ai3" target="p3-ai4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p3-ai4" target="p3-r13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3-ai4" target="p3-bs1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-bs1" target="p3-bs2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-bs2" target="p3-bs3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-bs3" target="p3-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge22" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-d3" target="p3-conflict"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3-conflict" target="p3-bs3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="2250"/><mxPoint x="200" y="2250"/></Array></mxGeometry></mxCell><mxCell id="p3-edge24" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3-d3" target="p3-bs4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-edge25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-bs4" target="p3-bs5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-note" value="&lt;b&gt;Lưu ý:&lt;/b&gt; eForm “/” và trang &lt;b&gt;/demo-luong&lt;/b&gt; cùng dùng bộ rule &lt;b&gt;pii-auto-1 (R1–R14)&lt;/b&gt; (từ 17/11/2026). Không còn bước bác sĩ duyệt tay bản đã che trước AI." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="260" height="130" as="geometry"/></mxCell><mxCell id="p3-lg" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1310" y="220" width="240" height="30" as="geometry"/></mxCell><mxCell id="p3-lg1" value="Bác sĩ thao tác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="254" width="240" height="34" as="geometry"/></mxCell><mxCell id="p3-lg2" value="Hệ thống xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="296" width="240" height="34" as="geometry"/></mxCell><mxCell id="p3-lg3" value="Điều kiện rẽ nhánh" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="338" width="200" height="60" as="geometry"/></mxCell><mxCell id="p3-lg4" value="🛡 Rule lọc dữ liệu nhạy cảm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1310" y="406" width="240" height="40" as="geometry"/></mxCell><mxCell id="p3-lg5" value="🛡 Biện pháp bảo vệ khác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e7;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="454" width="240" height="34" as="geometry"/></mxCell><mxCell id="p3-lg6" value="Chú thích" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="1"><mxGeometry x="1310" y="496" width="240" height="40" as="geometry"/></mxCell><mxCell id="p3-lg7" value="Sang trang khác (bấm để mở)" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;size=0.22;" vertex="1" parent="1"><mxGeometry x="1350" y="544" width="160" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
