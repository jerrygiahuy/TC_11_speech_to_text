<mxfile host="app.diagrams.net" type="device" version="24.0.0"><diagram id="p1" name="1. Nói → điền phiếu khám"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value="Luồng 1 · Bác sĩ nói → hệ thống điền phiếu khám" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="980" height="40" as="geometry"/></mxCell><mxCell id="p1-lane1" value="Bác sĩ" style="swimlane;startSize=36;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=14;fontStyle=1;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="960" as="geometry"/></mxCell><mxCell id="p1-lane2" value="Trình duyệt (máy bác sĩ)" style="swimlane;startSize=36;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=14;fontStyle=1;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="340" height="960" as="geometry"/></mxCell><mxCell id="p1-lane3" value="Máy chủ trong viện" style="swimlane;startSize=36;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=14;fontStyle=1;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="340" height="960" as="geometry"/></mxCell><mxCell id="p1-s" value="&lt;b&gt;Bắt đầu&lt;/b&gt;&lt;br&gt;Bác sĩ mở lượt khám đang khám" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="240" height="70" as="geometry"/></mxCell><mxCell id="p1-n1" value="Chọn cách ghi: &lt;b&gt;Hội thoại&lt;/b&gt; hoặc &lt;b&gt;Bác sĩ đọc&lt;/b&gt;, rồi bấm 🎤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="240" height="60" as="geometry"/></mxCell><mxCell id="p1-n2" value="Kiểm tra máy chủ đã có model nhận dạng giọng nói chưa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="240" width="240" height="60" as="geometry"/></mxCell><mxCell id="p1-d1" value="Có model&lt;br&gt;trên máy chủ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="200" height="100" as="geometry"/></mxCell><mxCell id="p1-no" value="Báo bác sĩ gõ tay.&lt;br&gt;Không gửi âm thanh ra ngoài để nhận dạng thay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e7;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="355" width="240" height="70" as="geometry"/></mxCell><UserObject label="Sang Luồng 2&lt;br&gt;(gõ)" link="data:page/id,p2" id="p1-toL2"><mxCell style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;size=0.22;" vertex="1" parent="1"><mxGeometry x="110" y="460" width="160" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p1-n3" value="Mở phiên ghi âm gắn đúng lượt khám, giữ micro.&lt;br&gt;Mất kết nối thì tự dừng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="355" width="240" height="70" as="geometry"/></mxCell><mxCell id="p1-n4" value="Thu âm; cứ 0,4 giây gửi một mẩu âm thanh tới máy chủ trong viện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="480" width="240" height="70" as="geometry"/></mxCell><mxCell id="p1-r9" value="&lt;b&gt;🛡 R9 · Âm thanh không rời máy chủ&lt;/b&gt;&lt;br&gt;Nhận dạng giọng nói ngay tại chỗ (Zipformer). Không lưu âm thanh.&lt;br&gt;&lt;font color=&quot;#7a2e2b&quot;&gt;&lt;i&gt;Căn cứ: HIPAA (P); NĐ 356 – dữ liệu sinh trắc học&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSiz